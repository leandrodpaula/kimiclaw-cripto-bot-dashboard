# MongoDB Atlas: adicione o IP da máquina em Network Access → IP Access List.
# Se o IP não estiver na whitelist, o handshake TLS falhará e o dashboard usa JSON local.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=kimi_trader

# Caminho opcional para dados JSON locais do bot (fallback se MongoDB indisponível).
# BOT_DATA_PATH=./demo_data
